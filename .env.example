# IAS-Viewer-Server — نمونه‌ی متغیرهای محیطی
# این فایل را به نام .env کپی کن و مقادیر خودت را بگذار.
# هیچ‌وقت فایل .env واقعی را کامیت نکن.

# توکن اختیاری برای محافظت از API (ساخت/حذف دوربین).
# یک رشته‌ی تصادفی طولانی بساز، مثلاً: openssl rand -hex 32
IVS_API_TOKEN=

# آدرس پایه‌ی HLS که داشبورد وب از آن استریم می‌گیرد
# (آی‌پی همین سرور؛ کلاینت‌ها باید به این آی‌پی دسترسی داشته باشند)
IVS_HLS_BASE=http://192.168.1.50:8888
